services:

  database:
    image: "postgres:16"
    container_name: "{{ vault_container_prefix | default('omero') }}-database"
    restart: unless-stopped
    environment:
      POSTGRES_USER: "{{ vault_postgres_user | default('omero') }}"
      POSTGRES_DB: "{{ vault_postgres_database | default('omero') }}"
      POSTGRES_PASSWORD: "{{ vault_postgres_password }}"
      POSTGRES_HOST_AUTH_METHOD: trust
    networks:
      - omero
    volumes:
      - "../database:/var/lib/postgresql/data"

  omeroserver:
    image: "cellularimagingcf/omeroserver:{{ vault_nl_biomero_version | default('latest') }}"
    container_name: "{{ vault_container_prefix | default('omero') }}-server"
    restart: unless-stopped
    security_opt:
      - seccomp=unconfined
    ulimits:
      nofile:
        soft: 8192
        hard: 65536
      nproc: 2048
      stack: 16777216
    environment:
      CONFIG_omero_db_host: database
      CONFIG_omero_db_user: "{{ vault_postgres_user | default('omero') }}"
      CONFIG_omero_db_pass: "{{ vault_postgres_password }}"
      CONFIG_omero_db_name: "{{ vault_postgres_database | default('omero') }}"
      CONFIG_omero_scripts_timeout: 604800000
      ROOTPASS: "{{ vault_omero_root_password }}"
{% if vault_omero_worker_enabled | default('FALSE') == 'TRUE' or vault_biomero_analyzer_enabled | default('FALSE') == 'TRUE' %}
      CONFIG_omero_master_host: omeroserver
      CONFIG_omero_server_nodedescriptors: "master:Blitz-0{% if vault_omero_worker_enabled | default('FALSE') == 'TRUE' %} omeroworker-1:Tables-0,Indexer-0,PixelData-0,DropBox,MonitorServer,FileServer,Storm{% endif %}{% if vault_biomero_analyzer_enabled | default('FALSE') == 'TRUE' %} biomeroworker:Processor-0{% endif %}"
{% endif %}
    networks:
      - omero
    ports:
      - "{{ vault_omero_server_port | default('4063') }}:4063"
      - "{{ vault_omero_server_ssl_port | default('4064') }}:4064"
    volumes:
      - "{{ vault_omero_data_path | default('/mnt/omero_data') }}:/OMERO"
      - "{{ vault_biomero_import_data_path }}:/data"
      - "./server_conf.omero:/opt/omero/server/config/server_conf.omero"
      - "../ssl/omero:/etc/ssl/omero:ro"
    depends_on:
      - database

{% if vault_omero_worker_enabled | default('FALSE') == 'TRUE' %}
  omeroworker-1:
    image: "cellularimagingcf/omeroworker:{{ vault_nl_biomero_version | default('latest') }}"
    container_name: "{{ vault_container_prefix | default('omero') }}-worker-1"
    restart: unless-stopped
    security_opt:
      - seccomp=unconfined
    ulimits:
      nproc: 2048
      stack: 16777216
    environment:
      CONFIG_omero_master_host: omeroserver
      OMERO_WORKER_NAME: omeroworker-1
      CONFIG_omero_scripts_timeout: 604800000
    networks:
      - omero
    volumes:
      - "{{ vault_omero_data_path | default('/mnt/omero_data') }}:/OMERO"
      - "{{ vault_biomero_import_data_path }}:/data"
    depends_on:
      - omeroserver

{% endif %}
{% if vault_biomero_analyzer_enabled | default('FALSE') == 'TRUE' %}
  biomeroworker:
    image: "cellularimagingcf/biomero:{{ vault_nl_biomero_version | default('latest') }}"
    container_name: "{{ vault_container_prefix | default('omero') }}-biomeroworker"
    restart: unless-stopped
    security_opt:
      - seccomp=unconfined
    ulimits:
      nproc: 2048
      stack: 16777216
    environment:
      CONFIG_omero_master_host: omeroserver
      OMERO_WORKER_NAME: biomeroworker
      CONFIG_omero_logging_level: 10
      CONFIG_omero_scripts_timeout: 604800000
      PERSISTENCE_MODULE: eventsourcing_sqlalchemy
      SQLALCHEMY_URL: "postgresql+psycopg2://{{ vault_biomero_postgres_user | default('biomero') }}:{{ vault_biomero_postgres_password }}@database-biomero:5432/{{ vault_biomero_postgres_database | default('biomero') }}"
    networks:
      - omero
    volumes:
      - "{{ vault_omero_data_path | default('/mnt/omero_data') }}:/OMERO"
      - "{{ vault_biomero_ssh_keys_path | default('/opt/omero/.ssh') }}:/tmp/.ssh:ro"
      - "../config/biomero/slurm-config.ini:/opt/omero/server/slurm-config.ini:rw"
      - "{{ vault_biomero_import_data_path }}:/data"
    depends_on:
      - omeroserver
      - database-biomero

{% endif %}
  database-biomero:
    image: "postgres:16"
    container_name: "{{ vault_container_prefix | default('omero') }}-database-biomero"
    restart: unless-stopped
    environment:
      POSTGRES_USER: "{{ vault_biomero_postgres_user | default('biomero') }}"
      POSTGRES_DB: "{{ vault_biomero_postgres_database | default('biomero') }}"
      POSTGRES_PASSWORD: "{{ vault_biomero_postgres_password }}"
    networks:
      - omero
    volumes:
      - "../database-biomero:/var/lib/postgresql/data"

  omeroweb:
    image: "cellularimagingcf/omeroweb:{{ vault_nl_biomero_version | default('latest') }}"
    container_name: "{{ vault_container_prefix | default('omero') }}-web"
    restart: unless-stopped
    environment:
      OMEROHOST: omeroserver
      OMEROPORT: "{{ vault_omero_server_ssl_port | default('4064') }}"
      CONFIG_omero_web_login__logo: "https://www.qualityzorg.nl/home/wp-content/uploads/LUMC-logo-1.png"
      CONFIG_omero_scripts_timeout: 604800000
      ENV: "{{ vault_biomero_env | default('TEST') }}"
      INGEST_TRACKING_DB_URL: "postgresql+psycopg2://{{ vault_biomero_postgres_user | default('biomero') }}:{{ vault_biomero_postgres_password }}@database-biomero:5432/{{ vault_biomero_postgres_database | default('biomero') }}"
      IMPORT_MOUNT_PATH: /data
      ROOTPASS: "{{ vault_omero_root_password }}"
      IMPORTER_ENABLED: "{{ vault_biomero_importer_enabled | default('TRUE') }}"
      ANALYZER_ENABLED: "{{ vault_biomero_analyzer_enabled | default('FALSE') }}"
{% if vault_biomero_analyzer_enabled | default('FALSE') == 'TRUE' %}
      METABASE_SITE_URL: "{{ vault_metabase_site_url }}"
      METABASE_SECRET_KEY: "{{ vault_metabase_secret_key }}"
      METABASE_IMPORTS_DB_PAGE_DASHBOARD_ID: "{{ vault_metabase_imports_dashboard_id }}"
      METABASE_WORKFLOWS_DB_PAGE_DASHBOARD_ID: "{{ vault_metabase_workflows_dashboard_id }}"
      FORMS_MASTER_USER: "{{ vault_forms_master_user }}"
      FORMS_MASTER_PASSWORD: "{{ vault_forms_master_password }}"
{% endif %}
    networks:
      - omero
    ports:
      - "{{ vault_omero_web_port | default('4080') }}:4080"
    volumes:
      - "{{ vault_biomero_import_data_path }}:/data:rw"
{% if vault_biomero_analyzer_enabled | default('FALSE') == 'TRUE' %}
      - "../config/biomero/slurm-config.ini:/opt/omero/web/OMERO.web/var/slurm-config.ini:rw"
{% endif %}
    depends_on:
      - omeroserver
      - database-biomero

  metabase:
    image: "metabase/metabase@sha256:f7b5dc52c21aaa2dca910a450e7e6119a975090ce9fc80726aa0742882ca176c"
    container_name: "{{ vault_container_prefix | default('omero') }}-metabase"
    hostname: metabase
    restart: unless-stopped
    environment:
      MB_DB_FILE: /metabase-data/metabase.db
      MB_USER: "{{ vault_metabase_user }}"
      MB_PASSWORD: "{{ vault_metabase_password }}"
    networks:
      - omero
    ports:
      - "{{ vault_metabase_port | default('3000') }}:3000"
    volumes:
      - "../metabase:/metabase-data"

{% if vault_biomero_importer_enabled | default('TRUE') == 'TRUE' %}
  biomero-importer:
    image: "cellularimagingcf/biomero-importer:{{ vault_biomero_importer_version | default('latest') }}"
    container_name: "{{ vault_container_prefix | default('omero') }}-importer"
    restart: unless-stopped
    privileged: true
    devices:
      - "/dev/fuse:/dev/fuse"
    security_opt:
      - "label=disable"
    environment:
      OMERO_HOST: omeroserver
      OMERO_PORT: "{{ vault_omero_server_ssl_port | default('4064') }}"
      OMERO_USER: "{{ vault_biomero_omero_user | default('root') }}"
      OMERO_PASSWORD: "{{ vault_omero_root_password }}"
      INGEST_TRACKING_DB_URL: "postgresql+psycopg2://{{ vault_biomero_postgres_user | default('biomero') }}:{{ vault_biomero_postgres_password }}@database-biomero:5432/{{ vault_biomero_postgres_database | default('biomero') }}"
    networks:
      - omero
    volumes:
      - "{{ vault_biomero_import_data_path }}:/data"
      - "../config/biomero-importer/groups_list.json:/auto-importer/config/groups_list.json"
    user: "{{ vault_biomero_importer_uid | default('1000') }}:{{ vault_biomero_importer_gid | default('1000') }}"
    depends_on:
      - database-biomero

{% endif %}
networks:
  omero:
    name: "{{ vault_container_prefix | default('omero') }}-network"
