# Ansible managed


#Client Server SSL verification
config set omero.glacier2.IceSSL.Ciphers "HIGH"
config set omero.glacier2.IceSSL.DefaultDir "/etc/ssl/omero"
config set omero.glacier2.IceSSL.CertFile "omero.p12"
config set omero.glacier2.IceSSL.CAs "omero.pem"
config set omero.certificates.key "omero.key"
config set omero.glacier2.IceSSL.Password "{{ vault_IceSSL_Password }}"
config set omero.glacier2.IceSSL.Protocols "tls1_2"
config set omero.glacier2.IceSSL.ProtocolVersionMin "tls1_2"
config set omero.glacier2.IceSSL.ProtocolVersionMax "tls1_2"
config set omero.security.trustStore "/etc/ssl/omero/.mykeystore"
config set omero.security.trustStorePassword "{{ vault_trustStorePassword }}"

# LDAP Configuration
{% if vault_ldap_enabled | default(false) %}
config set omero.ldap.config true
config set omero.ldap.base "{{ vault_ldap_base }}"
config set omero.ldap.urls "{{ vault_ldap_urls }}"
config set omero.ldap.username "{{ vault_ldap_username }}"
config set omero.ldap.password "{{ vault_ldap_password }}"
config set omero.ldap.user_filter "{{ vault_ldap_user_filter }}"
config set omero.ldap.user_mapping "{{ vault_ldap_user_mapping }}"
config set omero.ldap.group_filter "{{ vault_ldap_group_filter }}"
config set omero.ldap.group_mapping "{{ vault_ldap_group_mapping }}"
config set omero.ldap.new_user_group "{{ vault_ldap_new_user_group }}"
config set omero.security.ignore_case {{ vault_ldap_security_ignore_case | default(true) | lower }}
{% if vault_ldap_referral is defined %}
config set omero.ldap.referral "{{ vault_ldap_referral }}"
{% endif %}
{% if vault_ldap_sync_on_login is defined %}
config set omero.ldap.sync_on_login {{ vault_ldap_sync_on_login | lower }}
{% endif %}
{% else %}
config set omero.ldap.config false
{% endif %}

# Production settings for larger server
config set omero.db.poolsize 100
config set omero.jvmcfg.percent.blitz 50
config set omero.jvmcfg.percent.indexer 10
config set omero.jvmcfg.percent.pixeldata 40
config set omero.jvmcfg.max_system_memory 12000